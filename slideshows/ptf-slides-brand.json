{
  "_meta": {
    "name": "Skillcrush by PTF — Slides Brand Tokens",
    "version": "1.0.0",
    "rules_companion": "ptf-slides-brand-rules.md",
    "last_updated": "2026-06-11"
  },

  "logo": {
    "url": "https://raw.githubusercontent.com/skillcrush-curriculum/skillcrush-by-ptf-logo/main/skillcrush-by-ptf-2x.png",
    "placement": "top-right",
    "aspect_ratio": "8:3",
    "apply_to": "every slide"
  },

  "fonts": {
    "display": "Arimo",
    "body": "Arimo",
    "source": "Google Fonts",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "note": "Font name must be written exactly as 'Arimo' in all PPTX generation to ensure Google Slides match"
  },

  "typography_sizes": {
    "note": "All sizes in points. These are minimums for LAYOUT_WIDE (13.33x7.5in). Nothing goes below 13pt except slide counters.",
    "slide_title": { "min": 36, "max": 40, "weight": "bold" },
    "card_title": { "min": 18, "max": 20, "weight": "bold" },
    "body_text": { "min": 14, "max": 15, "weight": "regular" },
    "quote_sample": { "min": 13, "max": 14, "weight": "regular", "style": "italic" },
    "caption_sublabel": { "min": 13, "weight": "regular" },
    "section_label_allcaps": { "size": 11, "weight": "bold", "char_spacing": 1.5, "note": "Reads larger due to charSpacing — do not increase" },
    "slide_counter": { "size": 11, "weight": "regular", "note": "Exception to the 13pt floor — decorative only" }
  },

  "colors": {
    "ink": {
      "primary": "#0A0A0A",
      "secondary": "#2A2A2A",
      "tertiary": "#5C6F69"
    },
    "backgrounds": {
      "white": "#FFFFFF",
      "off_white": "#FAFAF6",
      "black": "#0A0A0A"
    },
    "brand_green": {
      "dark": "#0A8C66",
      "mid": "#4FE8A9"
    },
    "brand_purple": {
      "default": "#5B4FCF",
      "light": "#EEEBFF"
    },
    "iridescent": {
      "cyan": "#5BCFFF",
      "green": "#4FE8A9",
      "lime": "#D5FF66"
    },
    "border": "rgba(10, 10, 10, 0.08)"
  },

  "shadows": {
    "card": "0 1px 2px rgba(15,30,26,0.04), 0 8px 28px rgba(15,30,26,0.08)"
  },

  "border_radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "28px",
    "pill": "999px"
  },

  "buttons": {
    "on_light": {
      "backgrounds": ["#5B4FCF", "#0A8C66"],
      "text_color": "#FFFFFF",
      "shape": "pill",
      "border_radius": "999px",
      "border": "1.5px solid #0A0A0A",
      "font_family": "Arimo",
      "font_weight": 600,
      "font_size_px": 15
    },
    "on_dark": {
      "background": "#FFFFFF",
      "text_color": "#0A0A0A",
      "shape": "pill",
      "border_radius": "999px",
      "border": "1.5px solid #0A0A0A",
      "font_family": "Arimo",
      "font_weight": 600,
      "font_size_px": 15
    },
    "sizes": {
      "regular": {
        "padding_vertical_px": 14,
        "padding_horizontal_px": 26
      },
      "small": {
        "padding_vertical_px": 10,
        "padding_horizontal_px": 18,
        "font_size_px": 14
      }
    }
  },

  "presenters": [
    {
      "name": "Tauri",
      "headshot": "https://raw.githubusercontent.com/skillcrush-curriculum/brand-assets/6354141f2defe37dc4a3c4e388f46c0a3224e5e2/slideshows/headshots/TauriHS_Jan2022-rectangle.jpg"
    },
    {
      "name": "Emily",
      "headshot": "https://raw.githubusercontent.com/skillcrush-curriculum/brand-assets/6354141f2defe37dc4a3c4e388f46c0a3224e5e2/slideshows/headshots/emily-speaker-picture.png"
    }
  ]
}
